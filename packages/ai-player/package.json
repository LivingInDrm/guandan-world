{
  "name": "@guandan/ai-player",
  "version": "0.1.0",
  "description": "Guandan AI player for automated gameplay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "admin": "tsx src/admin.ts",
    "admin:build": "cd admin-ui && npm run build",
    "admin:dev": "cd admin-ui && npm run dev"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@guandan/sdk-ts": "workspace:*",
    "express": "^4.21.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0"
  },
  "files": [
    "dist"
  ]
}
